{
  "schemaVersion": 3,
  "project": {
    "name": "GetPatched",
    "repository": "getpatched/packaging-imagemagick",
    "description": "Target-specific ImageMagick security maintenance recipe."
  },
  "package": {
    "source": "imagemagick",
    "description": "Image processing library and command-line tools.",
    "upstreamProject": "ImageMagick",
    "upstreamRepository": "https://github.com/ImageMagick/ImageMagick",
    "copyrightFile": "LICENSES/debian-copyright"
  },
  "targets": [
    {
      "id": "debian-trixie-amd64",
      "file": "targets/debian/trixie-amd64.json"
    }
  ],
  "patchMetadata": "patches/metadata.json",
  "regressionTests": {
    "fixturesDirectory": "tests/fixtures",
    "runner": "getpatched/platform:verification/regression.py"
  },
  "licensing": {
    "publicContributionsSpdx": "MIT",
    "publicContributionsLicenseFile": "LICENSE",
    "fileLicenses": [
      {
        "path": "tests/fixtures/first-graya.png",
        "spdx": "MIT"
      },
      {
        "path": "tests/fixtures/second-srgb.png",
        "spdx": "MIT"
      },
      {
        "path": "tests/fixtures/cve-2026-116159.cdl.xml",
        "spdx": "MIT"
      },
      {
        "path": "tests/fixtures/cve-2026-116159-input.ppm",
        "spdx": "MIT"
      }
    ],
    "earlyBinaryLicenseId": null,
    "earlyBinaryTermsFile": null,
    "upstreamCopyrightFile": "LICENSES/debian-copyright",
    "upstreamLicenses": "preserve"
  }
}
